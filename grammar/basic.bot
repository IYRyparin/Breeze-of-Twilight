IDENTIFICATION CONFIGURATION-ID "example-configuration-id -> Breeze of Twilight";
IDENTIFICATION CONFIGURATION-VERSION 1.0;
IDENTIFICATION CONFIGURATION-ENCODE "UTF-8";
IDENTIFICATION CONFIGURATION-READONLY FALSE;

# This is an example notes.
# Well...only support this.
# meow...^-^

DATABASES-START;
{
    EXAMPLE_TABLE [TABLE<INT, STR, BOOL>] CST = NULL;
    EXAMPLE_PARTITION [DATABASE<BOOL>] CST = {
        EXAMPLE_BOOL_VALUE [BOOL] MUT = TRUE;
        EXAMPLE_OTHER_BOOL [BOOL] MUT = FALSE;
        EXAMPLE_SIMPLE_CALCULATION [BOOL] CST = FALSE;
    };
    LOAD_STRING [STR] CST = "Hello World!";
    LOAD-INT [INT] MUT = 1;
    LOAD-BOOL [BOOL] MUT = TRUE;
    RUN-COMP [FILE] CST = "./testW";
    PANE [STR] CST = "peokvmbokrgrgrgtwdfwrfrfftgtgyyjun";
    VK-ANY [ANYTHING] CST = 0x01;

    LOAD_LIMIT [INT] MUT = 0 -> LIMIT(1, 2, !5, !1_2);
    LOAD_REGULAR [STR] MUT = "Hello!!!!!!!!!!!!!!!!" -> REGULAR("^ACPacp$");
};
DATABASES-END;
