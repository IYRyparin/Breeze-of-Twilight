IDENTIFICATION CONFIGURATION_ID "example.basic-configuration";
IDENTIFICATION CONFIGURATION_VERSION 1.0;
IDENTIFICATION CONFIGURATION_READONLY FALSE;
IDENTIFICATION CONFIGURATION_ENCODE "utf-8";

# Note: This is the final example.

DATABASES_START;
{
    INT_STATE   [INT]   CST =   12345567;
    DEC_STAGE   [INT]   CST =   0d1_000_000;
    HEX_STATE   [INT]   CST =   0x0FAC  -> LIMIT(1,3,5,8 TO 10,0x0FAC);
    OCT_STATE   [INT]   CST =   0o7353;
    BIN_STATE   [INT]   CST =   0b10010010  ->  LIMIT(1 TO INFINITE);

    FLOAT_STATE [FLOAT] CST =   12.3431;YES
    DEC_FLOAT   [FLOAT] CST =   0d2342_21.2343_21_2456;
    HEX_FLOAT   [FLOAT] CST =   0xFC.0F3A;
    OCT_FLOAT   [FLOAT] CST =   0o23.12345;
    BIN_FLOAT   [FLOAT] CST =   0b101.1010101;

    INF_STATE   [INT]   MUT =   INFINITE;
    NAN_STATE   [INT]   MUT =   NOT_A_NUMBER;
    BOOL_TRUE   [BOOL]  CST =   TRUE;
    BOOL_FALSE  [BOOL]  CST =   FALSE;
    EMPTY_VAL   [FLOAT] CST =   NULL;

    ONE-STRING  [STRING]    CST =   "Hello World!";
};
DATABASES_END;